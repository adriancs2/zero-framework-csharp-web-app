<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS as the reverse proxy for cshttp Hearth CMS (Windows).

  IIS does NOT run any .NET code here. The HttpPlatformHandler module
  (https://www.iis.net/downloads/microsoft/httpplatformhandler) starts
  HearthCms.exe, hands it a loopback port in %HTTP_PLATFORM_PORT%, forwards
  every request to it over HTTP/1.1 and restarts the process if it dies.
  The application pool must be "No Managed Code".

  processesPerApplication MUST stay 1: sessions live in process memory
  (ConcurrentDictionary), exactly as with the original single-worker app pool.
-->
<configuration>
  <system.webServer>
    <handlers>
      <remove name="httpplatformhandler" />
      <add name="httpplatformhandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
    </handlers>

    <httpPlatform processPath=".\HearthCms.exe"
                  arguments="--quiet"
                  startupTimeLimit="60"
                  startupRetryCount="3"
                  rapidFailsPerMinute="10"
                  requestTimeout="00:05:00"
                  processesPerApplication="1"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\App_Data\logs\stdout">
      <environmentVariables>
        <environmentVariable name="DOTNET_gcServer" value="0" />
      </environmentVariables>
    </httpPlatform>

    <!-- Let the application's own error pages (404, 500 JSON) pass through untouched. -->
    <httpErrors existingResponse="PassThrough" />

    <security>
      <requestFiltering allowDoubleEscaping="true">
        <!-- 50 MB, same as the original Web.config and the app's MaxBodyBytes. -->
        <requestLimits maxAllowedContentLength="52428800" />
        <!-- App_Data is already a hidden segment in IIS's default configuration;
             the application also refuses to serve it. -->
      </requestFiltering>
    </security>

    <!-- The app compresses nothing itself; let IIS do it for text responses. -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
  </system.webServer>
</configuration>
